---
import Icon from './Icon.astro';
import ThemeOptions from './ThemeOptions.astro';
import { componentItem } from '../../lib/registry';
import { copyBundle } from '../../lib/registry-md';
import { getEntry } from 'astro:content';
import { Code } from 'astro/components';
interface Props {
  id: string;
  previewStacked?: boolean;
}
const { id, previewStacked } = Astro.props;
const entry = await getEntry('components', id);
if (!entry) throw new Error(`Missing component metadata: ${id}`);
const { title, summary: description, a11yPattern } = entry.data;
const item = componentItem(id, entry.data);
if (!item) throw new Error(`Missing source for ${id}`);
const { files, styles: orderedStyles, packages, example } = copyBundle(item);
if (!example) throw new Error(`Missing example: ${id}`);
---

<article class='component-card' id={id} data-copy-group>
  <header class='component-heading'>
    <div>
      <h3><a href={`#${id}`}>{title}</a></h3><p>{description}</p>
    </div><button
      class='copy-markdown'
      type='button'
      data-copy-url={`/components/${id}.md`}
      ><Icon name='copy' /> Copy as Markdown</button
    >
  </header>
  <p class='copy-status' data-copy-status role='status'></p>
  <div class='preview-toolbar'>
    <span>Preview theme</span>
    <ThemeOptions preview={`${id}-preview`} />
  </div>
  <div
    id={`${id}-preview`}
    class:list={['component-preview', { 'preview-stacked': previewStacked }]}
  >
    <slot name='preview' />
  </div>
  <details class='component-code'>
    <summary>Code & usage <span aria-hidden='true'>+</span></summary>
    <div class='example-code' data-copy-group>
      <div class='code-label'>
        <h4>Example</h4><button type='button' data-copy-target={`${id}-example`}
          >Copy example</button
        >
      </div><div id={`${id}-example`}>
        <Code
          lang='tsx'
          code={example}
          themes={{ light: 'github-light', dark: 'github-dark' }}
          defaultColor={false}
        />
      </div><p data-copy-status role='status' class='copy-status'></p>
    </div>
    <h4 class='source-title'>Files to copy</h4>
    <p class='source-note'>
      Copy these files into your project. Import the CSS once, after <a
        href='/handbook#using-components'>the shared theme</a
      >.
    </p>
    {
      files.map(file => (
        <div class='source-file' data-copy-group>
          <>
            <a href={file.url}>{file.target} ↗</a>
            <button type='button' data-copy-url={file.url}>
              Copy {file.lang === 'css' ? 'CSS' : 'source'}
            </button>
            <p data-copy-status role='status' class='copy-status' />
          </>
        </div>
      ))
    }
    <h4 class='source-title'>CSS imports</h4>
    <p class='source-note'>
      Add these imports once in your entry file in src/.
    </p>
    <pre><code>{orderedStyles.map(file => `import './${file.target.replace(/^src\//, '')}';`).join('\n')}</code></pre>
    <p class='source-note'>
      Requires {packages.join(', ')}. {
        a11yPattern && <a href={a11yPattern}>Interaction guidance ↗</a>
      }
    </p>
    <a class='text-link' href={`/components/${id}.md`}
      >Read the complete Markdown reference →</a
    >
  </details>
</article>
