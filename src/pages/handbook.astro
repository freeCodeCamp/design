---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const entry = await getEntry('guide', 'style-guide');
if (!entry) throw new Error('Style guide missing');
const { Content, headings } = await render(entry);
---

<BaseLayout
  title='Style guide'
  description={entry.data.description}
  markdown='/handbook.md'
>
  <main id='main' class='wrap' tabindex='-1'>
    <header class='page-intro' data-copy-group>
      <p class='eyebrow'>The thinking behind the details</p><h1>
        A shared language.<br /><span class='muted'>A familiar feeling.</span>
      </h1><p>{entry.data.description}</p><div class='actions'>
        <button class='copy-markdown' type='button' data-copy-url='/handbook.md'
          >Copy as Markdown ↗</button
        ><a class='text-link' href='/brand/asset-kit.zip' download
          >Download brand assets ↓</a
        >
      </div><p data-copy-status role='status' class='copy-status'></p>
    </header>
    <div class='guide-layout'>
      <aside class='guide-nav'>
        <p class='eyebrow'>In this guide</p><nav
          aria-label='Style guide sections'
        >
          {
            headings
              .filter(h => h.depth === 2)
              .map(h => <a href={`#${h.slug}`}>{h.text}</a>)
          }
        </nav>
      </aside><article class='guide-content'><Content /></article>
    </div>
  </main>
</BaseLayout>
