{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "design",
  "compatibility_date": "2026-08-05",
  // Non-production branches deploy via `wrangler versions upload`, which serves
  // each version at <version>-design.<subdomain>.workers.dev. Set explicitly:
  // preview URLs otherwise track `workers_dev`, so they would silently switch
  // off the day the custom domain lands and `workers_dev` is turned off.
  "preview_urls": true,
  // Off so the site exists on exactly one production origin. Otherwise
  // design.<subdomain>.workers.dev serves a byte-identical duplicate, and the
  // only thing keeping it out of search results is an X-Robots-Tag rule in
  // _headers. Branch previews are unaffected - `preview_urls` above is set
  // explicitly so it no longer tracks this flag.
  "workers_dev": false,
  // https://developers.cloudflare.com/workers/wrangler/configuration/#source-of-truth
  // Wrangler overrides dashboard routes on every deploy with whatever `routes`
  // holds. Declaring the custom domain here is what stops the next deploy from
  // detaching design.freecodecamp.org.
  "routes": [
    {
      "pattern": "design.freecodecamp.org",
      "custom_domain": true
    }
  ],
  // Assets-only Worker: no `main` entrypoint. The docs site is a pure Astro
  // SSG build, so every request is served straight from the asset store and
  // no Worker script is invoked. `_headers` and `_redirects` in dist/ are
  // consumed by the asset server, not served as assets.
  "assets": {
    "directory": "./dist",
    // dist/ has no 404.html - return a plain 404 for unknown paths rather
    // than rewriting them to index.html (this is a docs site, not an SPA).
    "not_found_handling": "none"
  }
}
