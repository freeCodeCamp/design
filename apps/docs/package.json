{
  "name": "@freecodecamp/uikit-docs",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "predev": "node scripts/copy-sprite.mjs && node scripts/build-asset-kit.mjs && node scripts/ensure-uikit-built.mjs && node scripts/build-cdn-bundle.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-sprite.mjs && node scripts/build-asset-kit.mjs && node scripts/ensure-uikit-built.mjs && node scripts/build-cdn-bundle.mjs",
    "build": "astro build && node scripts/verify-dist-pages-artefacts.mjs",
    "preview": "astro preview",
    "lint": "astro check && oxlint",
    "typecheck": "astro check"
  },
  "author": "freeCodeCamp.org <team@freecodecamp.org>",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeCodeCamp/UIkit.git",
    "directory": "apps/docs"
  },
  "bugs": {
    "url": "https://github.com/freeCodeCamp/UIkit/issues"
  },
  "homepage": "https://design.freecodecamp.org",
  "description": "freeCodeCamp UIKit - living design-system documentation site",
  "private": true,
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@freecodecamp/uikit": "workspace:^",
    "@freecodecamp/uikit-css": "workspace:^",
    "@freecodecamp/uikit-icons": "workspace:^",
    "@freecodecamp/uikit-js": "workspace:^",
    "astro": "^7.1.6",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lightningcss": "^1.33.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  }
}
