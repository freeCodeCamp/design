{
  "name": "freecodecamp-design",
  "type": "module",
  "scripts": {
    "prepare": "is-ci || husky",
    "dev": "ASTRO_DEV_BACKGROUND=0 portless design astro dev",
    "build": "astro build && node scripts/verify-dist.mjs",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy:cf": "pnpm build && wrangler deploy",
    "upload:cf": "pnpm build && wrangler versions upload",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "astro check",
    "format": "oxfmt --write . && prettier --write \"**/*.{astro,md,yaml,yml}\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.{astro,md,yaml,yml}\"",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.81.0",
    "portless": "0.15.6",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.11",
    "wrangler": "^4.129.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "**/*.{json,jsonc}": [
      "oxfmt --write"
    ],
    "**/*.{astro,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  }
}
