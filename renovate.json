{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>freeCodeCamp/renovate-config"],
  "packageRules": [
    {
      "description": "Hold majors of every dep for human review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Review framework dependency updates",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "astro",
        "@astrojs/**",
        "@ark-ui/**"
      ],
      "automerge": false
    }
  ]
}
