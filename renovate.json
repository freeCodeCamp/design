{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>freeCodeCamp/renovate-config"],
  "packageRules": [
    {
      "description": "Auto-merge dev-tooling minor + patch updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@types/**",
        "oxlint",
        "oxfmt",
        "prettier",
        "prettier-**",
        "vitest",
        "@vitest/**",
        "@testing-library/**",
        "jsdom",
        "is-ci",
        "husky",
        "lint-staged"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Hold majors of every dep for human review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Review framework dependency updates",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "astro",
        "@astrojs/**",
        "@ark-ui/**"
      ],
      "automerge": false
    }
  ]
}
